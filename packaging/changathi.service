[Unit]
Description=Changathi coding agent orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{systemdArgs .Args}}
Environment={{systemdQuote (printf "PATH=%s" .Path)}}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
