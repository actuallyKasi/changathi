<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.changathi</string>
  <key>ProgramArguments</key><array><string>/Users/you/.local/bin/changathi</string><string>daemon</string><string>start</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/Users/you/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Users/you/Library/Logs/changathi.log</string>
  <key>StandardErrorPath</key><string>/Users/you/Library/Logs/changathi.error.log</string>
</dict></plist>
