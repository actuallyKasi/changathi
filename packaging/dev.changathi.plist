<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.changathi</string>
  <key>ProgramArguments</key><array>{{range .Args}}<string>{{html .}}</string>{{end}}</array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{{html .Path}}</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>{{html .LogDir}}/changathi.log</string>
  <key>StandardErrorPath</key><string>{{html .LogDir}}/changathi.error.log</string>
</dict></plist>
